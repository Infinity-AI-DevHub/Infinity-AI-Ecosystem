# ---- Infinity Workspace API configuration -------------------------------------
# Copy to .env for local development. NEVER commit real secrets (blueprint 12).
# .env is gitignored; this example file is the only one that is tracked.

NODE_ENV=development
PORT=3500

# Bind to localhost so the API is reachable only through the reverse proxy. The
# default is 0.0.0.0, which publishes it on every interface — in production that
# means plain HTTP straight to the port, bypassing TLS and every security header.
HOST=127.0.0.1

# Honour X-Forwarded-For from the proxy, so the rate limiter and audit trail record
# the caller rather than the proxy. Defaults to on in production; set it false if the
# API is ever exposed without a proxy in front, or clients can spoof their address.
# TRUST_PROXY=true
PUBLIC_URL=http://localhost:4600
API_URL=http://localhost:3500
LOG_LEVEL=debug

# ---- database ----
# MySQL 8.0+ or MariaDB 10.4+. The schema and queries avoid everything that exists
# in only one of them, so the same migrations install on either. Use the
# utf8mb4_unicode_ci collation — MariaDB has no utf8mb4_0900_ai_ci, and tables
# inherit the database's collation. MAMP's default MySQL port is 8889.
DATABASE_URL=mysql://root:root@localhost:8889/ecosystem
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- security ----
# Generate with: openssl rand -hex 32
# Required, at least 32 characters. The process refuses to start without it in
# production. Move this into a managed KMS before going live.
DATA_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
# Opt in to the k-anonymity breached-password check (only a SHA-1 prefix is sent):
# BREACHED_PASSWORD_CHECK=enabled

# ---- object storage ----
# local = private directory (development). s3 = any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/objects
# S3_BUCKET=infinity-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# ---- transactional notifications ----
# The workspace does not host mailboxes; employee email lives in a separate
# application. What is configured here is only the system's own outbound mail:
# activation invitations and security notices. Without it, an invited person can
# never receive their activation link.
#
# log = development only (refused in production). smtp | provider = real delivery.
NOTIFY_DRIVER=smtp
NOTIFY_DEFAULT_DOMAIN=iinfinityai.com

# Every system message is sent from this address - invitations, password resets and
# anything added later. There is a single sender helper, so setting it here changes it
# everywhere rather than per message type.
NOTIFY_FROM_ADDRESS=noreply@iinfinityai.com

# Submission over STARTTLS on 587. Not 465: the client upgrades a plaintext connection
# and does not speak implicit TLS, so pointing it at the SMTPS port will hang.
SMTP_HOST=mail.iinfinityai.com
SMTP_PORT=587
SMTP_USER=noreply@iinfinityai.com
# Never commit this. Supply it from the environment or a secret store.
SMTP_PASSWORD=


# NOTIFY_PROVIDER_API_URL=
# NOTIFY_PROVIDER_API_KEY=

# ---- meetings ----
MEETING_PROVIDER=none
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
MEETING_RECORDING_ENABLED=false

# ---- malware scanning ----
# Without a scanner, uploads are recorded as `skipped` rather than assumed clean.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---- workers ----
# Set to false on API instances when workers run as a separate deployment.
WORKERS_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000

# ---- retention (days) ----
RETENTION_RECYCLE_BIN_DAYS=30
RETENTION_AUDIT_DAYS=730
RETENTION_NOTIFICATION_DAYS=90

# ---- seed (development) ----
SEED_COMPANY_NAME=Infinity AI
SEED_COMPANY_LEGAL_NAME=Infinity AI (Pvt) Ltd
SEED_DOMAIN=iinfinityai.com
SEED_ADMIN_EMAIL=admin@iinfinityai.com
# Leave SEED_ADMIN_PASSWORD unset to get a single-use activation link instead,
# which is the same path every other employee follows.
# SEED_ADMIN_PASSWORD=
