# ---- Infinity Workspace API configuration -------------------------------------
# Copy to .env for local development. NEVER commit real secrets (blueprint 12).
# .env is gitignored; this example file is the only one that is tracked.

NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:4000
LOG_LEVEL=debug

# ---- database ----
DATABASE_URL=postgres://infinity:infinity_dev_only@localhost:5432/infinity
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- security ----
# Generate with: openssl rand -hex 32
# Required, at least 32 characters. The process refuses to start without it in
# production. Move this into a managed KMS before going live.
DATA_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60
REQUIRE_MFA_FOR_ADMINS=true
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
# Opt in to the k-anonymity breached-password check (only a SHA-1 prefix is sent):
# BREACHED_PASSWORD_CHECK=enabled

# ---- object storage ----
# local = private directory (development). s3 = any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/objects
# S3_BUCKET=infinity-files
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# ---- transactional notifications ----
# The workspace does not host mailboxes; employee email lives in a separate
# application. What is configured here is only the system's own outbound mail:
# activation invitations and security notices. Without it, an invited person can
# never receive their activation link.
#
# log = development only (refused in production). smtp | provider = real delivery.
NOTIFY_DRIVER=log
NOTIFY_DEFAULT_DOMAIN=infinity.test
# NOTIFY_FROM_ADDRESS=no-reply@yourcompany.com
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_PROVIDER_API_URL=
# NOTIFY_PROVIDER_API_KEY=

# ---- meetings ----
MEETING_PROVIDER=none
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
MEETING_RECORDING_ENABLED=false

# ---- malware scanning ----
# Without a scanner, uploads are recorded as `skipped` rather than assumed clean.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---- workers ----
# Set to false on API instances when workers run as a separate deployment.
WORKERS_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000

# ---- retention (days) ----
RETENTION_RECYCLE_BIN_DAYS=30
RETENTION_AUDIT_DAYS=730
RETENTION_NOTIFICATION_DAYS=90

# ---- seed (development) ----
SEED_COMPANY_NAME=Infinity Holdings
SEED_DOMAIN=infinity.test
SEED_ADMIN_EMAIL=admin@infinity.test
# Leave SEED_ADMIN_PASSWORD unset to get a single-use activation link instead,
# which is the same path every other employee follows.
# SEED_ADMIN_PASSWORD=
