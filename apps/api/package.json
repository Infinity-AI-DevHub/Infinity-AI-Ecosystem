{
  "name": "@infinity/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/index.js",
    "start:worker": "node --enable-source-maps dist/src/workers/index.js",
    "dev": "npm run build && node --enable-source-maps dist/src/index.js",
    "migrate": "npm run build && node dist/src/cli/migrate.js",
    "seed": "npm run build && node dist/src/cli/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.js",
    "test:unit": "npm run build && node --test dist/test/unit.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "mysql2": "^3.24.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3"
  }
}
