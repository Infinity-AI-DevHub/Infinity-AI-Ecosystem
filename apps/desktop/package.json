{
  "name": "@infinity/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Infinity Workspace desktop client",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.json && npm run build:preload",
    "build:renderer": "npm --prefix ../web run build",
    "build": "npm run build:renderer && node scripts/copy-renderer.mjs && npm run build:main",
    "dev": "npm run build:main && cross-env INFINITY_DEV_SERVER=http://localhost:4600 electron .",
    "start": "npm run build && electron .",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js --sourcemap",
    "package": "npm run build && electron-builder --mac --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "feed": "node scripts/make-feed.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "author": "Infinity AI (Pvt) Ltd",
  "overrides": {
    "@noble/hashes": "^1.4.0"
  }
}
